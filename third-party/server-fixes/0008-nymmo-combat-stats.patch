+/**
+ * RAGNAROKMAC: NY-MMO skill tiers (patch 0008).
+ * Is this skill currently promoted to Hyper / Ultimate by something the player is wearing?
+ */
+static bool pc_skill_in_tier(const std::vector<s_item_bonus> &tier, uint16 skill_id)
+{
+	skill_id = skill_dummy2skill_id(skill_id);
+
+	for (const auto &it : tier) {
+		if (it.id == skill_id)
+			return true;
+	}
+
+	return false;
+}
+
+bool pc_is_hyper_skill(map_session_data *sd, uint16 skill_id)
+{
+	return sd != nullptr && skill_id != 0 && pc_skill_in_tier(sd->hyper_skills, skill_id);
+}
+
+bool pc_is_ultimate_skill(map_session_data *sd, uint16 skill_id)
+{
+	return sd != nullptr && skill_id != 0 && pc_skill_in_tier(sd->ultimate_skills, skill_id);
+}
