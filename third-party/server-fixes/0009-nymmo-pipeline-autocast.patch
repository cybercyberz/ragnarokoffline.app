 /*==========================================
  * Add effect to skill when hit successfully target
  *------------------------------------------*/
+/**
+ * RAGNAROKMAC: NY-MMO autospell rules (server-fixes patch 0009), checked before every proc roll.
+ *   - map scope from the item text: "(PVE)", "(PVP)", "(Half chance in PVP/WOE maps)"
+ *   - an enemy's "Disable the target's autocast" stops this player's own autospells for a while
+ *   - the other side's "Block Autocast": a chance that an autospell involving them does not fire
+ * NY-MMO's GM (2025-03-17): "Disable autocast and chance the autocast will not trigger is not the
+ * same stat." Returns false to skip this autospell; may halve rate.
+ */
+static bool skill_nymmo_autospell_ok( map_session_data& caster, block_list* other, uint8 flag, int32& rate ){
+	bool vs = map_flag_vs( caster.m );
+
+	if( ( flag&AUTOSPELL_NYMMO_PVE ) && vs )
+		return false;
+	if( ( flag&AUTOSPELL_NYMMO_PVP ) && !vs )
+		return false;
+	if( ( flag&AUTOSPELL_NYMMO_HALF_VS ) && vs )
+		rate /= 2;
+
+	if( DIFF_TICK( caster.nymmo_autocast_off_until, gettick() ) > 0 )
+		return false;
+
+	map_session_data* osd = BL_CAST( BL_PC, other );
+
+	if( osd != nullptr && osd != &caster && osd->bonus.block_autocast > 0 && rnd_chance( min( osd->bonus.block_autocast, 100 ), 100 ) )
+		return false;
+
+	return true;
+}
