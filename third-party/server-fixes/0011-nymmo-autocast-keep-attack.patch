diff --git a/src/map/unit.cpp b/src/map/unit.cpp
index 1d0b84b..403b289 100644
--- a/src/map/unit.cpp
+++ b/src/map/unit.cpp
@@ -1184,7 +1184,16 @@ bool unit_movepos(block_list *bl, int16 dst_x, int16 dst_y, int32 easy, bool che
 		return false;
 
 	unit_stop_walking( bl, USW_FIXPOS );
-	unit_stop_attack(bl);
+	// RAGNAROKMAC: unit (patch 0011) - an item's autocast must not cancel the wearer's own attack.
+	// TK_JUMPKICK / GC_CROSSIMPACT (bonus bAutoSpell on NY-MMO gear) reach this from
+	// skill_additional_effect while the player is auto-attacking. unit_stop_attack clears ud->target
+	// AND deletes the live attack timer, and the client sends CZ_REQUEST_ACT 7 only once, so the
+	// character silently stops swinging with no message. The after-cast delay still applies: the
+	// attack_continue branch of unit_attack_timer_sub re-arms at ud->canact_tick by itself.
+	// Only a player inside their own autocast is spared - a manual cast goes through
+	// unit_skilluse_id2, which stops the attack before ever reaching here, exactly as in vanilla.
+	if( !( battle_config.nymmo_autocast_keep_attack && sd != nullptr && sd->state.autocast ) )
+		unit_stop_attack(bl);
 
 	if( checkpath && (map_getcell(bl->m,dst_x,dst_y,CELL_CHKNOPASS) || !path_search(nullptr,bl->m,bl->x,bl->y,dst_x,dst_y,easy,CELL_CHKNOREACH)) )
 		return false; // Unreachable
