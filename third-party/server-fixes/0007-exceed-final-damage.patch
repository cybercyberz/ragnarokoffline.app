@@ -6750,6 +6750,112 @@ void battle_vanish_damage(map_session_data *sd, block_list *target, int32 flag)
  *	Initial refactoring by Baalberith
  *	Refined and optimized by helvetica
  */
+/**
+ * RAGNAROKMAC: NY-MMO "Exceed Final Damage".
+ *
+ * A percentage applied on top of the FINISHED damage of one attack - after the skill ratio,
+ * cards, DEF, element and the target's own reductions - not inside the damage formula:
+ *   5,000 damage with +10% Exceed Final Damage = 5,500.
+ * Every bonus that matches the attack is summed and applied once (the attacker's side), then the
+ * target's matching "Def" bonuses reduce the result the same way (summed, capped at 100%).
+ *
+ * Categories, as described by the NY-MMO server:
+ *   plain          every attack (normal, critical, skill, physical, magical, misc)
+ *   physical       any BF_WEAPON attack; magic: any BF_MAGIC attack; misc: BF_MISC
+ *   melee / range  BF_WEAPON at short / long range
+ *   normal / crit  a weapon attack that is not a skill / an attack that rolled a critical
+ *   <element>      a skill attack, by the element the attack actually used
+ */
+static int32 battle_exceed_skill_element( block_list& src, uint16 skill_id, uint16 skill_lv ){
+	int32 element = skill_get_ele( skill_id, skill_lv );
+
+	// Resolved here rather than with battle_get_*_element(), because those may re-run a skill's
+	// modifyElement() hook (and re-roll a random element) that the damage calculation already used.
+	if( element == ELE_WEAPON ){
+		const status_data* sstatus = status_get_status_data( src );
+
+		element = ( sstatus != nullptr ) ? sstatus->rhw.ele : ELE_NEUTRAL;
+	}else if( element == ELE_ENDOWED ){
+		element = status_get_attack_sc_element( &src, status_get_sc( &src ) );
+	}else if( element == ELE_RANDOM ){
+		element = ELE_NONE; // Which element was rolled is not knowable after the fact.
+	}
+
+	return element;
+}
+
+static void battle_calc_exceed_final_damage( Damage& d, block_list* src, block_list* target, uint16 skill_id, uint16 skill_lv ){
+	map_session_data* sd = BL_CAST( BL_PC, src );
+	map_session_data* tsd = BL_CAST( BL_PC, target );
+
+	if( ( sd == nullptr && tsd == nullptr ) || d.damage + d.damage2 < 1 ){
+		return;
+	}
+
+	bool weapon = ( d.flag&BF_WEAPON ) != 0;
+	bool magic = ( d.flag&BF_MAGIC ) != 0;
+	bool misc = ( d.flag&BF_MISC ) != 0;
+	bool melee = weapon && ( d.flag&BF_SHORT ) != 0;
+	bool ranged = weapon && ( d.flag&BF_LONG ) != 0;
+	bool normal = weapon && skill_id == 0;
+	bool critical = ( d.type == DMG_CRITICAL || d.type == DMG_MULTI_HIT_CRITICAL );
+	int32 element = ( skill_id != 0 && src != nullptr ) ? battle_exceed_skill_element( *src, skill_id, skill_lv ) : ELE_NONE;
+	bool has_element = element > ELE_NONE && element < ELE_ALL;
+
+	int32 rate = 0;
+
+	if( sd != nullptr ){
+		rate += sd->bonus.exceed_final_dmg;
+
+		if( weapon ) rate += sd->bonus.exceed_final_dmg_phys;
+		if( magic ) rate += sd->bonus.exceed_final_dmg_magic;
+		if( misc ) rate += sd->bonus.exceed_final_dmg_misc;
+		if( melee ) rate += sd->bonus.exceed_final_dmg_melee;
+		if( ranged ) rate += sd->bonus.exceed_final_dmg_range;
+		if( normal ) rate += sd->bonus.exceed_final_dmg_normal;
+		if( critical ) rate += sd->bonus.exceed_final_dmg_crit;
+		if( has_element ) rate += sd->indexed_bonus.exceed_final_dmg_skillele[element] + sd->indexed_bonus.exceed_final_dmg_skillele[ELE_ALL];
+	}
+
+	int32 reduction = 0;
+
+	if( tsd != nullptr ){
+		reduction += tsd->bonus.exceed_final_dmg_def;
+
+		if( weapon ) reduction += tsd->bonus.exceed_final_dmg_phys_def;
+		if( magic ) reduction += tsd->bonus.exceed_final_dmg_magic_def;
+		if( misc ) reduction += tsd->bonus.exceed_final_dmg_misc_def;
+		if( melee ) reduction += tsd->bonus.exceed_final_dmg_melee_def;
+		if( ranged ) reduction += tsd->bonus.exceed_final_dmg_range_def;
+		if( normal ) reduction += tsd->bonus.exceed_final_dmg_normal_def;
+		if( critical ) reduction += tsd->bonus.exceed_final_dmg_crit_def;
+		if( has_element ) reduction += tsd->indexed_bonus.exceed_final_dmg_skillele_def[element] + tsd->indexed_bonus.exceed_final_dmg_skillele_def[ELE_ALL];
+	}
+
+	if( rate < -100 ){
+		rate = -100; // Never turn an attack into healing.
+	}
+
+	reduction = cap_value( reduction, 0, 100 );
+
+	if( rate == 0 && reduction == 0 ){
+		return;
+	}
+
+	if( rate != 0 ){
+		d.damage = d.damage / 100 * ( 100 + rate ) + d.damage % 100 * ( 100 + rate ) / 100;
+		d.damage2 = d.damage2 / 100 * ( 100 + rate ) + d.damage2 % 100 * ( 100 + rate ) / 100;
+	}
+
+	if( reduction != 0 ){
+		d.damage = d.damage / 100 * ( 100 - reduction ) + d.damage % 100 * ( 100 - reduction ) / 100;
+		d.damage2 = d.damage2 / 100 * ( 100 - reduction ) + d.damage2 % 100 * ( 100 - reduction ) / 100;
+	}
+
+	d.damage = i64max( d.damage, 0 );
+	d.damage2 = i64max( d.damage2, 0 );
+}
+
 struct Damage battle_calc_attack(int32 attack_type,block_list *bl,block_list *target,uint16 skill_id,uint16 skill_lv,int32 flag)
 {
 	struct Damage d;
@@ -6787,6 +6893,9 @@ struct Damage battle_calc_attack(int32 attack_type,block_list *bl,block_list *ta
 	else // Some skills like Weaponry Research will cause damage even if attack is dodged
 		d.dmg_lv = ATK_DEF;
 
+	// RAGNAROKMAC: NY-MMO "Exceed Final Damage" - applied to the finished damage of this attack.
+	battle_calc_exceed_final_damage(d, bl, target, skill_id, skill_lv);
+
 	map_session_data *sd = BL_CAST(BL_PC, bl);
 
 	if (sd && d.damage + d.damage2 > 1)
