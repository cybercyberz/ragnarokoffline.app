@@ -6895,6 +7017,8 @@ struct Damage battle_calc_attack(int32 attack_type,block_list *bl,block_list *ta
 
 	// RAGNAROKMAC: NY-MMO "Exceed Final Damage" - applied to the finished damage of this attack.
 	battle_calc_exceed_final_damage(d, bl, target, skill_id, skill_lv);
+	// RAGNAROKMAC: NY-MMO evasion / perfect block / absorb / lifesteal (patch 0008).
+	battle_calc_nymmo_combat(d, bl, target, skill_id);
 
 	map_session_data *sd = BL_CAST(BL_PC, bl);
 
