+/**
+ * RAGNAROKMAC: NY-MMO combat stats (server-fixes patch 0008).
+ *
+ * Runs on the finished damage of one attack, straight after battle_calc_exceed_final_damage(),
+ * in the order the NY-MMO descriptions imply:
+ *
+ *   1. evasion and blocking - one roll per matching kind, first success avoids the attack whole
+ *   2. perfect block        - the hit lands but deals 1
+ *   3. perfect defense / absorb - percentages off the finished damage, summed and capped at 100%
+ *   4. lifesteal           - the attacker heals a share of what actually landed
+ *
+ * Each defensive chance is reduced by the attacker's matching "Anti" bonus before it is rolled.
+ * Only a player has any of these, so an attack between two monsters returns immediately.
+ *
+ * These are OUR reading of the item descriptions, not NY-MMO's formula, which is not public.
+ * tools/nymmo_bonuses.txt documents every bonus; tools/nymmo_todo.md lists what was left out
+ * because no description defines it (notably "chance to max damage").
+ */
+static void battle_calc_nymmo_combat( Damage& d, block_list* src, block_list* target, uint16 skill_id ){
+	map_session_data* sd = BL_CAST( BL_PC, src );
+	map_session_data* tsd = BL_CAST( BL_PC, target );
+
+	if( ( sd == nullptr && tsd == nullptr ) || d.damage + d.damage2 < 1 ){
+		return;
+	}
+
+	bool weapon = ( d.flag&BF_WEAPON ) != 0;
+	bool magic = ( d.flag&BF_MAGIC ) != 0;
+	bool melee = weapon && ( d.flag&BF_SHORT ) != 0;
+	bool normal = weapon && skill_id == 0;
+	bool critical = ( d.type == DMG_CRITICAL || d.type == DMG_MULTI_HIT_CRITICAL );
+	bool hyper = pc_is_hyper_skill( sd, skill_id );
+	bool ultimate = pc_is_ultimate_skill( sd, skill_id );
+
+	if( tsd != nullptr ){
+		struct s_nymmo_evasion {
+			int32 chance;
+			int32 anti;
+			bool applies;
+		} rolls[] = {
+			{ tsd->bonus.hyper_skill_eva,  sd != nullptr ? sd->bonus.anti_hyper_skill_eva : 0,  hyper },
+			{ tsd->bonus.ultimate_eva,     sd != nullptr ? sd->bonus.anti_ultimate_eva : 0,     ultimate },
+			{ tsd->bonus.crit_eva,         sd != nullptr ? sd->bonus.anti_crit_eva : 0,         critical },
+			{ tsd->bonus.all_skill_eva,    sd != nullptr ? sd->bonus.anti_all_skill_eva : 0,    skill_id != 0 },
+			{ tsd->bonus.block_normal_atk, sd != nullptr ? sd->bonus.anti_block_normal_atk : 0, normal },
+			{ tsd->bonus.weapon_blocking2, sd != nullptr ? sd->bonus.anti_weapon_blocking : 0,  melee },
+		};
+
+		for( const s_nymmo_evasion& roll : rolls ){
+			if( !roll.applies ){
+				continue;
+			}
+
+			int32 chance = roll.chance - roll.anti;
+
+			if( chance > 0 && rnd_chance( chance, 100 ) ){
+				d.damage = 0;
+				d.damage2 = 0;
+				d.dmg_lv = ATK_FLEE;
+				return;
+			}
+		}
+
+		int32 block = tsd->bonus.perfect_block - ( sd != nullptr ? sd->bonus.accuracy_rate : 0 );
+
+		if( block > 0 && rnd_chance( block, 100 ) ){
+			// "chance to receive of 1 damage" - the attack connects, it just does nothing.
+			d.damage = ( d.damage > 0 ) ? 1 : 0;
+			d.damage2 = ( d.damage2 > 0 ) ? 1 : 0;
+			return;
+		}
+	}
+
+	int32 reduction = 0;
+
+	if( tsd != nullptr ){
+		int32 penetrate = ( sd != nullptr ) ? sd->bonus.penetrate : 0;
+		int32 anti_absorb = ( sd != nullptr ) ? sd->bonus.anti_absorb_dmg : 0;
+
+		reduction += cap_value( tsd->bonus.perfect_defense - penetrate, 0, INT32_MAX );
+		reduction += cap_value( tsd->bonus.absorb_dmg_ny - anti_absorb, 0, INT32_MAX );
+
+		if( magic ){
+			reduction += cap_value( tsd->bonus.absorb_magic_dmg - anti_absorb, 0, INT32_MAX );
+		}
+	}
+
+	reduction = cap_value( reduction, 0, 100 );
+
+	if( reduction != 0 ){
+		d.damage -= d.damage / 100 * reduction + d.damage % 100 * reduction / 100;
+		d.damage2 -= d.damage2 / 100 * reduction + d.damage2 % 100 * reduction / 100;
+		d.damage = i64max( d.damage, 0 );
+		d.damage2 = i64max( d.damage2, 0 );
+	}
+
+	if( sd != nullptr ){
+		int32 rate = sd->bonus.lifesteal + ( magic ? sd->bonus.magic_lifesteal : 0 );
+
+		if( tsd != nullptr ){
+			rate -= tsd->bonus.anti_lifesteal;
+		}
+
+		if( rate > 0 ){
+			int64 heal = ( d.damage + d.damage2 ) * rate / 100;
+
+			if( heal > 0 ){
+				status_heal( src, heal, 0, 1 );
+			}
+		}
+	}
+}
