+/**
+ * RAGNAROKMAC: NY-MMO damage pipeline (server-fixes patch 0009).
+ *
+ * NY-MMO's GMs stated the order on their Discord (2023-10-17):
+ *   Main DMG => DMG Limit => Exceed DMG => Penalty DMG => Trigger Reflect
+ * and that the limit is 49,999,999 per hit ("it damages 49m to 79m only", 2023-10-16), with
+ * "Exceed Damage - We have a maximum damage limit on the server, this stat will exceed that".
+ * Players describe "chance to max damage" as a proc that makes the hit land on that limit.
+ *
+ *   1. rAthena's damage, plus bHpBasedDmgPre (a share of the target player's current HP)
+ *   2. max-damage proc: a skill hit that rolls it counts as having reached the limit
+ *   3. the limit: nymmo_damage_limit, or the attacker's highest bDamageLimit
+ *   4. Exceed: a hit that reached the limit becomes limit * (1 + (Exceed - target's Exceed DEF)%)
+ *      - the Exceed part is cut by nymmo_pvp_exceed_penalty on PvP/WoE maps;
+ *      then bFinalDmgFlat is added and the target's bFinalDmgFlatDef taken off
+ *   5. HP-based damage after the limit, the PvP HP-above bonus, Hyper-skill reduction
+ *   6. PvP/WoE penalty on the total (player vs player only)
+ *   7. what the hit sets off: AP recovery, Disable Autocast, Interrupt
+ * Reflect is rAthena's own and runs afterwards, as NY-MMO orders it.
+ *
+ * nymmo_damage_limit 0 switches the limit off: Exceed is then 0007's plain percentage on every hit.
+ * Semantics are OUR reading of what the GMs and the item descriptions say - see
+ * tools/nymmo_bonuses.txt.
+ */
+static int64 battle_nymmo_pct( int64 value, int32 pct ){
+	return value / 100 * pct + value % 100 * pct / 100;
+}
+
+/// Put a new total back into a hit, keeping the right/left hand split of a dual-wield attack.
+static void battle_nymmo_set_total( Damage& d, int64 total ){
+	int64 old = d.damage + d.damage2;
+
+	total = i64max( total, 0 );
+
+	if( old <= 0 || d.damage2 == 0 ){
+		d.damage = total;
+		d.damage2 = 0;
+		return;
+	}
+
+	int64 left = (int64)( (double)total * (double)d.damage2 / (double)old );
+
+	d.damage2 = left;
+	d.damage = total - left;
+}
+
+static void battle_calc_nymmo_pipeline( Damage& d, block_list* src, block_list* target, uint16 skill_id, uint16 skill_lv ){
+	map_session_data* sd = BL_CAST( BL_PC, src );
+	map_session_data* tsd = BL_CAST( BL_PC, target );
+	int64 limit = battle_config.nymmo_damage_limit;
+
+	if( limit > 0 && sd != nullptr ){
+		limit = i64max( limit, sd->bonus.damage_limit );
+	}
+
+	if( limit <= 0 ){
+		// No limit: 0007's Exceed, unchanged.
+		battle_calc_exceed_final_damage( d, src, target, skill_id, skill_lv );
+	}
+
+	if( ( sd == nullptr && tsd == nullptr ) || d.damage + d.damage2 < 1 ){
+		return;
+	}
+
+	bool weapon = ( d.flag&BF_WEAPON ) != 0;
+	bool magic = ( d.flag&BF_MAGIC ) != 0;
+	bool hyper = pc_is_hyper_skill( sd, skill_id );
+	bool pvp = sd != nullptr && tsd != nullptr && map_flag_vs( target->m );
+	int32 hp_nullify = ( tsd != nullptr ) ? cap_value( tsd->bonus.hp_based_nullify + tsd->bonus.blue_dmg_def, 0, 100 ) : 0;
+	int64 total = d.damage + d.damage2;
+
+	// 1. a share of the target player's current HP, before the limit
+	if( sd != nullptr && tsd != nullptr && sd->bonus.hp_based_dmg_pre > 0 ){
+		int64 extra = battle_nymmo_pct( status_get_hp( target ), sd->bonus.hp_based_dmg_pre );
+
+		total += battle_nymmo_pct( extra, 100 - hp_nullify );
+	}
+
+	if( limit > 0 ){
+		bool reached = total >= limit;
+
+		// 2. chance to max damage - skills only, as every description says
+		if( !reached && sd != nullptr && skill_id != 0 ){
+			int32 chance = 0;
+
+			if( weapon ){
+				chance += sd->bonus.max_dmg_chance_phys + ( hyper ? sd->bonus.max_dmg_chance_hyper_phys : 0 );
+				chance -= ( tsd != nullptr ) ? tsd->bonus.max_dmg_chance_phys_def : 0;
+			}else if( magic ){
+				chance += sd->bonus.max_dmg_chance_magic + ( hyper ? sd->bonus.max_dmg_chance_hyper_magic : 0 );
+				chance -= ( tsd != nullptr ) ? tsd->bonus.max_dmg_chance_magic_def : 0;
+			}
+
+			if( chance > 0 && rnd_chance( min( chance, 100 ), 100 ) ){
+				reached = true;
+			}
+		}
+
+		// 3 + 4. the limit, and what Exceed adds beyond it
+		if( reached ){
+			int32 rate = 0, reduction = 0;
+
+			battle_calc_exceed_final_damage( d, src, target, skill_id, skill_lv, &rate, &reduction );
+
+			int64 over = battle_nymmo_pct( limit, max( rate - reduction, 0 ) );
+
+			if( pvp ){
+				over = battle_nymmo_pct( over, 100 - battle_config.nymmo_pvp_exceed_penalty );
+			}
+
+			total = limit + over;
+		}
+	}
+
+	if( sd != nullptr ){
+		total += sd->bonus.final_dmg_flat;
+	}
+
+	if( tsd != nullptr ){
+		total -= tsd->bonus.final_dmg_flat_def;
+	}
+
+	// 5. after the limit
+	if( sd != nullptr && tsd != nullptr ){
+		int32 chance = sd->bonus.hp_based_dmg_chance - tsd->bonus.hp_based_dmg_def;
+
+		if( chance > 0 && sd->bonus.hp_based_dmg_rate > 0 && rnd_chance( min( chance, 100 ), 100 ) ){
+			int64 extra = battle_nymmo_pct( status_get_hp( target ), sd->bonus.hp_based_dmg_rate );
+
+			total += battle_nymmo_pct( extra, 100 - hp_nullify );
+		}
+
+		if( sd->bonus.pvp_hp_above_dmg != 0 && status_get_max_hp( target ) > 0 &&
+			get_percentage( status_get_hp( target ), status_get_max_hp( target ) ) > (uint32)sd->bonus.pvp_hp_above ){
+			total += battle_nymmo_pct( total, sd->bonus.pvp_hp_above_dmg );
+		}
+	}
+
+	if( tsd != nullptr && hyper && tsd->bonus.hyper_dmg_reduce_chance > 0 &&
+		rnd_chance( min( tsd->bonus.hyper_dmg_reduce_chance, 100 ), 100 ) ){
+		total -= battle_nymmo_pct( total, cap_value( tsd->bonus.hyper_dmg_reduce, 0, 100 ) );
+	}
+
+	// 6. Penalty DMG
+	if( pvp ){
+		total = battle_nymmo_pct( total, 100 - battle_config.nymmo_pvp_damage_penalty );
+	}
+
+	battle_nymmo_set_total( d, total );
+
+	// 7. what the hit sets off, player against player (population bots are players too)
+	if( sd == nullptr || tsd == nullptr || d.damage + d.damage2 < 1 ){
+		return;
+	}
+
+	if( sd->bonus.ap_on_hit_player > 0 && sd->bonus.ap_on_hit_player_chance > 0 &&
+		rnd_chance( min( sd->bonus.ap_on_hit_player_chance, 100 ), 100 ) ){
+		status_heal( src, 0, 0, sd->bonus.ap_on_hit_player, 1 );
+	}
+
+	if( tsd->bonus.ap_when_hit_player > 0 && tsd->bonus.ap_when_hit_player_chance > 0 &&
+		rnd_chance( min( tsd->bonus.ap_when_hit_player_chance, 100 ), 100 ) ){
+		status_heal( target, 0, 0, tsd->bonus.ap_when_hit_player, 1 );
+	}
+
+	int32 chance = sd->bonus.disable_autocast_chance - tsd->bonus.anti_disable_autocast;
+
+	if( chance > 0 && sd->bonus.disable_autocast_duration > 0 && rnd_chance( min( chance, 100 ), 100 ) ){
+		tsd->nymmo_autocast_off_until = gettick() + sd->bonus.disable_autocast_duration;
+	}
+
+	chance = sd->bonus.interrupt_attack - tsd->bonus.interrupt_attack_resist;
+
+	if( chance > 0 && tsd->ud.attacktimer != INVALID_TIMER && rnd_chance( min( chance, 100 ), 100 ) ){
+		unit_stop_attack( target );
+	}
+}
